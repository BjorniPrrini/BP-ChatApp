<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="summaryPanel" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatappfrontend.frontend.controller.SummaryPanelController" styleClass="summary-panel" prefWidth="350" minWidth="350" maxWidth="350">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="summary-header">
            <padding>
                <Insets top="10" bottom="10" left="15" right="10"/>
            </padding>

            <Label text="Conversation Summary" styleClass="summary-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="✕" styleClass="icon-button" onAction="#handleClose"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="summary-content">
            <ProgressIndicator fx:id="summaryLoadingIndicator" prefWidth="45" prefHeight="45"/>

            <ScrollPane fx:id="summaryScrollPane" visible="false" managed="false" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="summary-scroll">
                <Label fx:id="summaryLabel" wrapText="true" styleClass="summary-text">
                    <padding>
                        <Insets top="15" bottom="15" left="15" right="15"/>
                    </padding>
                </Label>
            </ScrollPane>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="8" styleClass="summary-footer">
            <padding>
                <Insets top="10" bottom="15" left="15" right="15"/>
            </padding>

            <Label fx:id="errorLabel" wrapText="true" visible="false" managed="false" styleClass="summary-error"/>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="quotaLabel" text="Tries left today: -" styleClass="summary-quota"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="resummarizeButton" text="Resummarize" disable="true" styleClass="settings-button" onAction="#handleResummarize"/>
            </HBox>

            <Label fx:id="refreshedLabel" visible="false" managed="false" styleClass="summary-time"/>
        </VBox>
    </bottom>
</BorderPane>