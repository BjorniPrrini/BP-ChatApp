<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatappfrontend.frontend.controller.ChatPageController" stylesheets="@../styles/main.css">
    <Pane styleClass="chat-background"/>

    <HBox>
        <VBox styleClass="icon-bar" prefWidth="60" alignment="TOP_CENTER" spacing="10">
            <padding><Insets top="20" bottom="20"/></padding>

            <Button text="💬" styleClass="icon-button" onAction="#showConversations"/>
            <Button text="⚙️" styleClass="icon-button" onAction="#showSettings"/>
            <Button text="👥" styleClass="icon-button" onAction="#showFriends"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⏻" styleClass="logout-button" onAction="#handleLogout"/>
        </VBox>

        <VBox styleClass="fixed-panel" prefWidth="400">
            <VBox fx:id="conversationsPanel" VBox.vgrow="ALWAYS">
                <padding><Insets top="15" left="10" right="10" bottom="10"/></padding>

                <Label text="Chats" styleClass="panel-title"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search users or message..." styleClass="search-field" HBox.hgrow="ALWAYS"/>

                    <Button styleClass="fab-button" text="+" onAction="#handleOpenStartChatPopup"/>
                </HBox>

                <ListView fx:id="conversationList" VBox.vgrow="ALWAYS" styleClass="conversation-list"/>
            </VBox>

            <VBox fx:id="settingsPanel" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <padding><Insets top="15" left="10" right="10" bottom="10"/></padding>

                <Label text="Settings" styleClass="panel-title"/>

                <Button text="Change Password" styleClass="settings-button" onAction="#handleChangePassword"/>
                <Button text="Edit Profile" styleClass="settings-button" onAction="#handleEditProfile"/>
                <Button text="Upload Profile Picture" styleClass="settings-button" onAction="#handleProfilePicture"/>
                <Button text="Theme Manager" styleClass="settings-button" onAction="#handleThemeManager"/>
            </VBox>

            <VBox fx:id="friendsPanel" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="15" left="10" right="10" bottom="10"/>
                </padding>

                <Label text="Friends" styleClass="panel-title"/>

                <Button text="Add Friends" styleClass="settings-button" onAction="#handleAddFriends"/>
                <Button text="Friend Requests" styleClass="settings-button" onAction="#handleFriendRequests"/>
                <Button text="My Friends" styleClass="settings-button" onAction="#handleMyFriends"/>
                <Button text="Suggested Friends" styleClass="settings-button" onAction="#handleSuggestedFriends"/>
                <Button text="Blocked Users" styleClass="settings-button" onAction="#handleBlockedUsers"/>
            </VBox>
        </VBox>

        <StackPane fx:id="contentPane" HBox.hgrow="ALWAYS">
            <VBox fx:id="chatArea" styleClass="chat-area">
                <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="10" bottom="10" left="15" right="15"/>
                    </padding>

                    <Label fx:id="chatNameLabel" text="Select a conversation" styleClass="chat-name"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="summarizeButton" text="Summarize" styleClass="settings-button" onAction="#handleOpenSummary"/>

                    <Button fx:id="editGroupButton" text="Edit" styleClass="settings-button" onAction="#handleEditGroup" visible="false" managed="false"/>
                </HBox>

                <Label fx:id="notificationLabel" styleClass="notification-label" visible="false" managed="false"/>

                <HBox VBox.vgrow="ALWAYS">
                    <ScrollPane fx:id="messagesScrollPane" HBox.hgrow="ALWAYS" fitToWidth="true" styleClass="messages-scroll">
                        <VBox fx:id="messagesContainer" styleClass="messages-container" spacing="8">
                            <padding>
                                <Insets top="10" bottom="10" left="15" right="15"/>
                            </padding>
                        </VBox>
                    </ScrollPane>

                    <fx:include source="summary-panel-page.fxml" fx:id="summaryPanel" visible="false" managed="false"/>
                </HBox>

                <VBox fx:id="replyPreviewBox" visible="false" managed="false"/>

                <HBox styleClass="message-input-area" alignment="CENTER" spacing="10">
                    <padding>
                        <Insets top="10" bottom="10" left="15" right="15"/>
                    </padding>

                    <TextField fx:id="messageInput" promptText="Type a message..." HBox.hgrow="ALWAYS" styleClass="message-input"/>

                    <Button text="Send" styleClass="primary-button" onAction="#handleSendMessage"/>
                </HBox>
            </VBox>
        </StackPane>
    </HBox>
</StackPane>