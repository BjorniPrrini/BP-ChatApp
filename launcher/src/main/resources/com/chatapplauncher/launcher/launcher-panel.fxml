<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatapplauncher.launcher.controllers.LauncherPageController" alignment="CENTER" spacing="16" prefWidth="420" prefHeight="260" styleClass="launcher-root" stylesheets="@styles/main.css">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32"/>
    </padding>

    <Label text="BP-Chat" styleClass="title-label"/>

    <Label fx:id="statusLabel" text="Searching for update..." styleClass="status-label" wrapText="true"/>

    <ProgressIndicator fx:id="spinner" prefWidth="48" prefHeight="48"/>

    <VBox fx:id="progressBox" alignment="CENTER" spacing="6" visible="false" managed="false">
        <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
        <Label fx:id="percentLabel" text="0%" styleClass="percent-label"/>
    </VBox>

    <HBox fx:id="failedBox" alignment="CENTER" spacing="12" visible="false" managed="false">
        <Button text="Retry" onAction="#onRetryClicked" defaultButton="true" styleClass="launcher-button"/>
    </HBox>
</VBox>